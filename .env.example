# ---- Server ----
PORT=3000
# 127.0.0.1 = hanya bisa dibuka dari komputer ini. Untuk online, pakai 0.0.0.0 di belakang HTTPS.
HOST=127.0.0.1
# Alamat publik aplikasi (dipakai untuk link verifikasi email & redirect Google). Tanpa garis miring di akhir.
APP_URL=http://localhost:3000
# 1 jika aplikasi diakses lewat HTTPS (wajib saat online)
COOKIE_SECURE=0
# 1 jika berada di belakang reverse proxy (Nginx, Caddy, Railway, Render, dll.)
TRUST_PROXY=0

# ---- Akun ----
# Email yang otomatis jadi admin (pisahkan koma). User pertama yang daftar juga otomatis admin.
ADMIN_EMAILS=
# 0 = tutup pendaftaran akun baru
ALLOW_REGISTER=1

# ---- Login Google (Google Cloud Console > Credentials > OAuth client ID) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email verifikasi (SMTP) ----
# Contoh Gmail: smtp.gmail.com / 465 / alamat Gmail / App Password 16 digit
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LUKI MANAGEMENT <no-reply@domainmu.com>"

# ---- Telegram (chat @BotFather > /newbot) ----
TELEGRAM_BOT_TOKEN=
# Jam paling awal (0-23) pengingat H-7/H-3/H-2/H-1 dikirim tiap hari
REMINDER_HOUR=8
