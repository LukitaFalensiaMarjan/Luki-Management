# ==============================================================
# LUKI MANAGEMENT - Production Environment Configuration Template
# ==============================================================

# Server Network & URL
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000

# Production Flags (Set to 1 when behind HTTPS reverse proxy)
COOKIE_SECURE=0
TRUST_PROXY=0

# Security & Registration
ADMIN_EMAILS=admin@example.com
ALLOW_REGISTER=1

# Google OAuth 2.0 Credentials (PKCE)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP Email Configuration (Nodemailer Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password
MAIL_FROM="LUKI MANAGEMENT" <your-email@gmail.com>

# Telegram Reminder Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
REMINDER_HOUR=8
